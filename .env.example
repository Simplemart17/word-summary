# Settings for running Selah in Docker. Copy this file to .env and fill it in.
# .env holds secrets and is not kept in git.

# The password asked for before anything is shown. At least 10 characters.
SELAH_PASSWORD=

# Lets the container use your Claude subscription. On your own computer run
#   claude setup-token
# and paste the token it prints here.
CLAUDE_CODE_OAUTH_TOKEN=

# Which tunnel to start:
#   quick   no Cloudflare account; a new random address each time it starts
#   named   a fixed address on your own domain; needs TUNNEL_TOKEN below
# Leave it empty to start no tunnel and use http://localhost:4747 only.
COMPOSE_PROFILES=quick

# For the named tunnel: the token Cloudflare shows when you create the tunnel.
TUNNEL_TOKEN=

# The port on this computer. Change it if 4747 is already in use.
SELAH_PORT=4747
